{
  "name": "@paullefizelier/wp-to-strapi-adapter",
  "version": "0.1.0",
  "description": "Native Strapi adapter — implements StrapiAdapter via strapi.documents() + the upload service",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paullefizelier/wp-to-strapi.git",
    "directory": "packages/strapi-adapter"
  },
  "bugs": {
    "url": "https://github.com/paullefizelier/wp-to-strapi/issues"
  },
  "homepage": "https://github.com/paullefizelier/wp-to-strapi/tree/main/packages/strapi-adapter#readme",
  "keywords": ["strapi", "adapter", "wordpress", "migration"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0"
  },
  "dependencies": {
    "@paullefizelier/wp-to-strapi-core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "engines": { "node": ">=20" }
}
