# WordPress source
WP_BASE_URL=https://example.com
# Optional: only needed for private content or drafts (Basic auth or Application Password)
WP_USERNAME=
WP_APP_PASSWORD=

# Strapi v5 destination
STRAPI_BASE_URL=http://localhost:1337
STRAPI_API_TOKEN=your-strapi-api-token-with-full-access

# API UIDs (adjust to match your Strapi content-types)
STRAPI_POST_UID=api::post.post
STRAPI_PAGE_UID=api::page.page

# Tuning
CONCURRENCY=4
PAGE_SIZE=100
STATE_FILE=./.migration-state.json
DRY_RUN=false
