WP_BASE_URL=https://example.com
WP_USERNAME=
WP_APP_PASSWORD=

STRAPI_BASE_URL=http://localhost:1337
STRAPI_API_TOKEN=your-strapi-api-token-with-full-access

STRAPI_POST_UID=api::post.post
STRAPI_PAGE_UID=api::page.page

# Leave empty to skip the taxonomy. When set, terms are migrated before posts and related.
STRAPI_CATEGORY_UID=
STRAPI_TAG_UID=
# Override only when the REST path is not the naive pluralisation of the UID.
STRAPI_CATEGORY_PLURAL=
STRAPI_TAG_PLURAL=

# Statuses to fetch. Anything beyond `publish` needs WP_USERNAME/WP_APP_PASSWORD and lands
# in Strapi as a draft. e.g. publish,draft,pending,future,private
WP_STATUSES=publish

# Custom post types: restBase:uid[|pluralPath], comma separated.
# e.g. portfolio:api::project.project,event:api::event.event|evenements
WP_CUSTOM_TYPES=

# Scrape the public page when the REST body is empty or comes from a page builder.
HTML_FALLBACK=true

CONCURRENCY=4
PAGE_SIZE=100
STATE_FILE=./.migration-state.json
DRY_RUN=false
