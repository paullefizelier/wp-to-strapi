{
  "name": "strapi-plugin-wp-import",
  "version": "0.1.0",
  "description": "Import content from WordPress into Strapi — installed as a plugin, runs in the admin panel",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paullefizelier/wp-to-strapi.git",
    "directory": "apps/strapi-plugin"
  },
  "bugs": {
    "url": "https://github.com/paullefizelier/wp-to-strapi/issues"
  },
  "homepage": "https://github.com/paullefizelier/wp-to-strapi/tree/main/apps/strapi-plugin#readme",
  "keywords": ["strapi", "plugin", "strapi-plugin", "wordpress", "import", "migration"],
  "strapi": {
    "name": "wp-import",
    "displayName": "WP Import",
    "description": "Import posts, pages, and media from a WordPress site",
    "kind": "plugin"
  },
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE", "strapi-admin.js", "strapi-server.js"],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "typecheck": "tsc --noEmit -p admin/tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "prepublishOnly": "npm run build && npm run verify"
  },
  "dependencies": {
    "@paullefizelier/wp-to-strapi-core": "^0.1.0",
    "@paullefizelier/wp-to-strapi-adapter": "^0.1.0"
  },
  "devDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/sdk-plugin": "^5.3.0",
    "@strapi/strapi": "^5.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "prettier": "^3.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-intl": "^6.6.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "engines": { "node": ">=20" }
}
